{
  "name": "league-replay-analyzer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @lra/web run dev",
    "build:web": "npm --workspace @lra/web run build",
    "check:web": "npm --workspace @lra/web run check",
    "test:web": "npm --workspace @lra/web run test",
    "typecheck:web": "npm --workspace @lra/web run typecheck",
    "build:native": "pwsh -File ./scripts/build-native.ps1 -UseNinja",
    "build:wasm": "pwsh -File ./scripts/build-wasm.ps1",
    "build:provisional-schema": "node ./scripts/build_provisional_schema.mjs",
    "build:corpus-schema": "node ./scripts/build_corpus_schema.mjs",
    "inspect:runtime-schema-drift": "node ./scripts/inspect_runtime_schema_drift.mjs",
    "discover:scalar-metric": "node ./scripts/discover_scalar_metric_candidates.mjs",
    "discover:scalar-metric-sweep": "node ./scripts/sweep_scalar_metric_discovery.mjs",
    "inspect:scalar-metric": "node ./scripts/inspect_scalar_metric_candidate.mjs",
    "build:scalar-family-bundles": "node ./scripts/build_scalar_family_bundle_candidates.mjs",
    "recommend:scalar-family-bundles": "node ./scripts/recommend_scalar_family_bundle_metrics.mjs",
    "analyze:scalar-family-layout": "node ./scripts/analyze_scalar_family_layout.mjs",
    "summarize:scalar-hotspots": "node ./scripts/summarize_scalar_family_hotspots.mjs",
    "discover:keyframe-parity": "node ./scripts/discover_keyframe_api_parity.mjs",
    "build:keyframe-parity-schema": "node ./scripts/build_keyframe_parity_schema.mjs",
    "diagnose:keyframe-slot-conflicts": "node ./scripts/diagnose_keyframe_slot_conflicts.mjs",
    "assign:keyframe-participant-slots": "node ./scripts/assign_keyframe_participant_slots.mjs",
    "analyze:keyframe-identity-order": "node ./scripts/analyze_keyframe_identity_order.mjs",
    "assign:keyframe-rofl-stats": "node ./scripts/assign_keyframe_slots_from_rofl_stats.mjs",
    "compare:keyframe-rofl-stats": "node ./scripts/compare_rofl_stat_assignments_to_supervised.mjs",
    "validate:keyframe-rofl-stats": "node ./scripts/validate_keyframe_state_against_rofl_stats.mjs",
    "scan:keyframe-identifiers": "node ./scripts/scan_keyframe_identifier_tokens.mjs",
    "scan:startup-roster-tokens": "node ./scripts/scan_startup_roster_tokens.mjs",
    "scan:keyframe-state-band": "node ./scripts/scan_keyframe_state_band.mjs",
    "scan:keyframe-handle-graph": "node ./scripts/scan_keyframe_handle_graph.mjs",
    "scan:keyframe-handle-graph-corpus": "node ./scripts/run_keyframe_handle_graph_corpus.mjs",
    "score:keyframe-handle-graph": "node ./scripts/score_keyframe_handle_graph_candidates.mjs",
    "export:keyframe-state": "node ./scripts/export_keyframe_state_prototype.mjs",
    "summarize:keyframe-export-coverage": "node ./scripts/summarize_keyframe_export_coverage.mjs",
    "summarize:latest-keyframe-state": "node ./scripts/summarize_latest_keyframe_state.mjs",
    "summarize:keyframe-export-quality": "node ./scripts/summarize_keyframe_export_quality.mjs",
    "summarize:keyframe-blockers": "node ./scripts/summarize_keyframe_blockers.mjs",
    "verify:keyframe-state": "node ./scripts/verify_keyframe_state_exports.mjs",
    "extract:replay-stats": "node ./scripts/extract_replay_stats.mjs",
    "validate:replay-stats": "node ./scripts/validate_extracted_stats.mjs",
    "discover:movement": "node ./scripts/discover_movement_candidates.mjs",
    "extract:movement": "node ./scripts/extract_replay_movement.mjs",
    "validate:movement": "node ./scripts/validate_movement_candidates.mjs",
    "build:movement-coordinate-model": "node ./scripts/build_movement_coordinate_model.mjs",
    "build:movement-priors": "node ./scripts/build_movement_identity_priors.mjs",
    "build:movement-16.7-model": "node ./scripts/build_movement_16_7_model.mjs",
    "diagnose:movement-alignment": "node ./scripts/diagnose_movement_alignment.mjs",
    "extract:calibrated-movement": "node ./scripts/extract_calibrated_movement.mjs",
    "assign:movement": "node ./scripts/assign_replay_movement.mjs",
    "validate:assigned-movement": "node ./scripts/validate_assigned_movement.mjs",
    "extract:api-static-state": "node ./scripts/extract_api_static_state.mjs",
    "diagnose:static-metrics": "node ./scripts/diagnose_static_metric_alignment.mjs",
    "discover:item-events": "node ./scripts/discover_item_event_candidates.mjs",
    "test:native": "pwsh -File ./scripts/test-native.ps1 -UseNinja",
    "fetch:riot": "node ./scripts/fetch-riot-match-data.mjs",
    "publish:riot-fixtures": "node ./scripts/publish-riot-fixtures.mjs",
    "publish:replay-movement": "node ./scripts/publish-replay-movement-fixtures.mjs",
    "compare:riot": "node ./scripts/correlate-replay-api.mjs"
  },
  "devDependencies": {
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.11.1"
}
