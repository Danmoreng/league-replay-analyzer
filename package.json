{
  "name": "league-replay-analyzer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @lra/web run dev",
    "build:web": "npm --workspace @lra/web run build",
    "check:web": "npm --workspace @lra/web run check",
    "test:web": "npm --workspace @lra/web run test",
    "typecheck:web": "npm --workspace @lra/web run typecheck",
    "build:native": "pwsh -File ./scripts/build-native.ps1 -UseNinja",
    "build:wasm": "pwsh -File ./scripts/build-wasm.ps1",
    "build:provisional-schema": "node ./scripts/build_provisional_schema.mjs",
    "build:corpus-schema": "node ./scripts/build_corpus_schema.mjs",
    "discover:scalar-metric": "node ./scripts/discover_scalar_metric_candidates.mjs",
    "discover:scalar-metric-sweep": "node ./scripts/sweep_scalar_metric_discovery.mjs",
    "inspect:scalar-metric": "node ./scripts/inspect_scalar_metric_candidate.mjs",
    "build:scalar-family-bundles": "node ./scripts/build_scalar_family_bundle_candidates.mjs",
    "recommend:scalar-family-bundles": "node ./scripts/recommend_scalar_family_bundle_metrics.mjs",
    "analyze:scalar-family-layout": "node ./scripts/analyze_scalar_family_layout.mjs",
    "summarize:scalar-hotspots": "node ./scripts/summarize_scalar_family_hotspots.mjs",
    "extract:replay-stats": "node ./scripts/extract_replay_stats.mjs",
    "validate:replay-stats": "node ./scripts/validate_extracted_stats.mjs",
    "discover:movement": "node ./scripts/discover_movement_candidates.mjs",
    "extract:movement": "node ./scripts/extract_replay_movement.mjs",
    "validate:movement": "node ./scripts/validate_movement_candidates.mjs",
    "build:movement-coordinate-model": "node ./scripts/build_movement_coordinate_model.mjs",
    "build:movement-priors": "node ./scripts/build_movement_identity_priors.mjs",
    "assign:movement": "node ./scripts/assign_replay_movement.mjs",
    "validate:assigned-movement": "node ./scripts/validate_assigned_movement.mjs",
    "test:native": "pwsh -File ./scripts/test-native.ps1 -UseNinja",
    "fetch:riot": "node ./scripts/fetch-riot-match-data.mjs",
    "publish:riot-fixtures": "node ./scripts/publish-riot-fixtures.mjs",
    "compare:riot": "node ./scripts/correlate-replay-api.mjs"
  },
  "devDependencies": {
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.11.1"
}
