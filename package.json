{
  "name": "league-replay-analyzer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @lra/web run dev",
    "build:web": "npm --workspace @lra/web run build",
    "check:web": "npm --workspace @lra/web run check",
    "test:web": "npm --workspace @lra/web run test",
    "typecheck:web": "npm --workspace @lra/web run typecheck",
    "build:native": "pwsh -File ./scripts/build-native.ps1 -UseNinja",
    "build:wasm": "pwsh -File ./scripts/build-wasm.ps1",
    "test:native": "pwsh -File ./scripts/test-native.ps1 -UseNinja"
  },
  "devDependencies": {
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.11.1"
}
